{
  "$schema": "tealight-tokens/1.0",
  "$description": "Tealight design tokens. Source of truth for prototype CSS variables (--color-*, --font-*, --space-*, etc.) and native themes. Contrast ratios are against the theme's `room` colour. No pure white, no pure black, no red anywhere.",
  "meta": {
    "name": "Tealight",
    "storeName": "Tealight: Focus Layer",
    "version": "1.0.0",
    "defaultTheme": "evening"
  },
  "color": {
    "evening": {
      "$description": "Dark, the default. A tealight in a dim room at dusk.",
      "room": "#2E2320",
      "roomRaised": "#3A2D29",
      "roomSunken": "#251C19",
      "line": "#4E3F39",
      "wax": "#F1E7DE",
      "waxDim": "#BCA79C",
      "waxFaint": "#8E7A70",
      "flame": "#F5B941",
      "flameDeep": "#E09A2B",
      "wick": "#93A8E8",
      "glow": "rgba(245,185,65,0.14)",
      "onFlame": "#2E2320",
      "focusRing": "#93A8E8",
      "warning": "#F5B941",
      "earLeft": "#93A8E8",
      "earRight": "#F5B941",
      "scrim": "rgba(31,23,21,0.72)"
    },
    "daylight": {
      "$description": "Light. Pale window-grey, not cream. flameText (#A86A00) is only for text >=16px semibold, or icons.",
      "room": "#E9E7EE",
      "roomRaised": "#F7F6F9",
      "roomSunken": "#DEDBE4",
      "line": "#CFCBD6",
      "wax": "#2E2320",
      "waxDim": "#5F5059",
      "waxFaint": "#7D707A",
      "flame": "#F5B941",
      "flameText": "#A86A00",
      "flameDeep": "#E09A2B",
      "wick": "#4659A8",
      "glow": "rgba(245,185,65,0.20)",
      "onFlame": "#2E2320",
      "focusRing": "#4659A8",
      "warning": "#A86A00",
      "earLeft": "#4659A8",
      "earRight": "#A86A00",
      "scrim": "rgba(46,35,32,0.40)"
    },
    "lowGlow": {
      "$description": "Night palette. Automatic for Sleep and Unwind after local sunset (or always, by setting). No blue. Spec: nothing on screen above ~40 cd/m2 at default brightness; the brightest pixel is the ember, everything else stays below it.",
      "room": "#1F1715",
      "roomRaised": "#2A201D",
      "roomSunken": "#1A1311",
      "line": "#3A2D29",
      "wax": "#B9998A",
      "waxDim": "#8C7266",
      "waxFaint": "#6A564D",
      "flame": "#C9893A",
      "flameDeep": "#A86E2C",
      "wick": "#C9893A",
      "glow": "rgba(201,137,58,0.10)",
      "onFlame": "#1F1715",
      "focusRing": "#C9893A",
      "warning": "#C9893A",
      "earLeft": "#B9998A",
      "earRight": "#C9893A",
      "scrim": "rgba(20,15,13,0.80)",
      "maxLuminanceCdM2": 40
    },
    "contrast": {
      "evening.wax": "12.5:1",
      "evening.waxDim": "6.3:1",
      "daylight.wax": "13:1",
      "daylight.flameText": "4.6:1 (text >=16px semibold or icons only)",
      "daylight.wick": "5.9:1",
      "lowGlow.wax": "6:1 (deliberately lower)"
    },
    "rules": [
      "Saffron (flame) means sound is on. Never use it decoratively while idle except on the primary action.",
      "Left ear is always wick (periwinkle), right ear is always flame (saffron). Low glow merges both into ember.",
      "One glow per screen, behind the flame. No other gradients.",
      "No red, ever. Warnings use `warning` + an icon + plain words."
    ]
  },
  "font": {
    "family": {
      "display": "'Young Serif', Georgia, serif",
      "ui": "'Lexend', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "legibleA": "'Lexend', system-ui, sans-serif",
      "legibleB": "'Atkinson Hyperlegible Next', 'Atkinson Hyperlegible', system-ui, sans-serif",
      "numeric": "'Lexend', system-ui, sans-serif"
    },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Young+Serif&family=Lexend:wght@300..600&family=Atkinson+Hyperlegible+Next:wght@400;600&display=swap",
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600 },
    "numericFeatures": "tabular-nums",
    "rules": [
      "Young Serif is display only: intent word, session-end line, wordmark. Never below 22px, never for controls.",
      "Legible mode swaps every display role to Lexend 500 or Atkinson Hyperlegible Next 600.",
      "Sentence case everywhere. No all-caps labels. Science sheet line length <= 60ch."
    ]
  },
  "type": {
    "$description": "1.25 scale, base 16. size/lineHeight in px.",
    "caption":  { "size": 13, "lineHeight": 18, "family": "ui", "weight": 400 },
    "body":     { "size": 16, "lineHeight": 26, "family": "ui", "weight": 400 },
    "label":    { "size": 16, "lineHeight": 22, "family": "ui", "weight": 500 },
    "title":    { "size": 20, "lineHeight": 28, "family": "ui", "weight": 500 },
    "heading":  { "size": 25, "lineHeight": 32, "family": "display", "weight": 400 },
    "headingL": { "size": 31, "lineHeight": 38, "family": "display", "weight": 400 },
    "readout":  { "size": 56, "lineHeight": 60, "family": "numeric", "weight": 300, "letterSpacing": "-0.01em" },
    "intent":   { "size": 56, "lineHeight": 64, "family": "display", "weight": 400 },
    "earValue": { "size": 20, "lineHeight": 26, "family": "numeric", "weight": 500 }
  },
  "space": {
    "$description": "4px base grid.",
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64,
    "gutter": 20,
    "minTapTarget": 48,
    "primaryTarget": 120
  },
  "radius": {
    "sm": 8,
    "md": 14,
    "lg": 22,
    "sheet": 28,
    "pill": 999
  },
  "elevation": {
    "$description": "No drop shadows on Evening/Low glow; separation is by room/roomRaised. Daylight may use one soft shadow on sheets.",
    "sheetDaylight": "0 -8px 32px rgba(46,35,32,0.10)"
  },
  "motion": {
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "fade": "linear",
      "breath": "cubic-bezier(0.37, 0, 0.63, 1)"
    },
    "duration": {
      "$description": "ms. Visual fades are bound to audio fades: motion follows sound.",
      "instant": 0,
      "ui": 200,
      "detent": 120,
      "sheet": 280,
      "holdToStart": 1200,
      "lightFadeIn": 8000,
      "lightFadeInSteady": 15000,
      "lightFadeInSteadyMax": 20000,
      "soften": 1200,
      "goOut": 30000,
      "pauseFade": 1500,
      "driftCycle": 10000,
      "smokeCurl": 4000
    },
    "drift": {
      "leanDeg": 2,
      "heightPct": 3,
      "cycleMs": 10000
    },
    "rules": [
      "Nothing moves on launch.",
      "The only ambient motion is Drift (10s cycle). Steady and Reduce Motion = perfectly still flame.",
      "Never visualise the beat frequency. No flashing, no pulsing faster than one cycle per 6 s.",
      "No springs, no bounce, no confetti, no shake."
    ]
  },
  "depth": {
    "$description": "Layer level relative to the user's other audio. Labelled by position, never by percentage. Values are the engine volume (0..1, perceptual).",
    "surface": 0.45,
    "under": 0.28,
    "deep": 0.14,
    "defaultStop": "under",
    "ceilingDefault": 0.6,
    "steadyFadeInSec": 15
  },
  "haptics": {
    "default": "off",
    "whenOn": "one soft tick on start and on stop; nothing else"
  }
}
